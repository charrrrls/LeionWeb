extends includes/layout.pug

block content
  -
    const en = config.language === 'en'
    const albums = site.photoGallery.albums.filter(item => item.photos.length)
    const collections = albums.filter(item => !item.archive)
    const name = item => en ? item.en : item.title
    const count = n => en ? n + (n === 1 ? ' photo' : ' photos') : n + ' 张照片'
    const media = photo => '/gallery/media/' + photo.sha + '.webp'
    const thumb = photo => '/gallery/thumbs/' + photo.sha + '.webp'
    const cover = item => item.photos.find(photo => photo.file === item.cover) || item.photos[0]
    const coverAlt = item => cover(item).file === item.cover && item.alt ? (en ? item.alt.en : item.alt.zh) : name(item)
    const albumUrl = item => url_for('/gallery/' + item.slug + '/')
    const galleryTitle = en ? 'Photography Gallery' : '摄影图集'

  mixin albumCard(item, featured)
    - const photo = cover(item)
    a.album-card(class=featured ? 'album-feature' : '' href=albumUrl(item) data-folder=item.folder)
      .album-cover
        if featured
          picture
            source(media='(max-width: 600px)' srcset=thumb(photo))
            img(src=media(photo) width=photo.width height=photo.height alt=coverAlt(item) loading='eager' fetchpriority='high')
        else
          img(src=thumb(photo) width=photo.width height=photo.height alt=coverAlt(item) loading='lazy')
      .album-caption
        .album-label
          h2= name(item)
          span.album-meta= count(item.photos.length)
        span.album-arrow(aria-hidden='true') →

  section.photo-library.nc
    header.photo-heading
      h1= galleryTitle
      .photo-meta
        if collections.length
          if collections.every(item => item.city === '南京')
            span= en ? 'Nanjing' : '南京'
          span= en ? collections.length + (collections.length === 1 ? ' album' : ' albums') : collections.length + ' 本相册'
    if page.legacy_album_link
      p.gallery-missing(hidden)= en ? 'This album is unavailable. Choose another album below.' : '这个相册暂时无法打开，可以从下方选择其他相册。'
    if collections.length
      .album-shelf
        each item, i in collections
          +albumCard(item, i === 0)
    else
      p= en ? 'No photo albums yet.' : '暂无摄影相册。'
    each item in albums.filter(item => item.archive)
      a.photo-archive(href=albumUrl(item) data-folder=item.folder)= name(item) + ' →'
    if page.legacy_album_link
      script(src=url_for('/js/gallery.js'))

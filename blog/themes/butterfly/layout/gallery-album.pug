-
  const en = config.language === 'en'
  const album = page.album
  const title = en ? album.en : album.title
  const galleryTitle = en ? 'All albums' : '全部相册'
  const globalPageType = 'page'
  const thumbnailWidth = (photo, edge) => Math.max(1, Math.round(photo.width * Math.min(1, edge / Math.max(photo.width, photo.height))))
  const originalRoot = 'https://raw.githubusercontent.com/charrrrls/mypic/' + site.photoGallery.revision + '/' + encodeURIComponent(album.folder) + '/'
mixin icon(path)
  svg(viewBox='0 0 24 24' width='20' height='20' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' focusable='false')
    path(d=path)
mixin wallThumbnail(photo, thumb, small, sources, sizes, alt, index)
  picture
    if sources
      source(media='(max-width: 480px)' srcset=small)
    img(src=thumb srcset=sources sizes=sources && sizes width=photo.width height=photo.height alt=alt loading=index < 3 ? 'eager' : 'lazy' fetchpriority=index === 0 ? 'high' : undefined decoding='async')
doctype html
html(lang=config.language)
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1,viewport-fit=cover')
    meta(name='theme-color' content='#191b1b')
    meta(name='author' content=config.author)
    title= title + ' | ' + config.title
    link(rel='canonical' href=url)
    include includes/head/Open_Graph.pug
    != favicon_tag(theme.favicon || config.favicon)
    link(rel='stylesheet' href=url_for('/css/gallery-album.css'))
    script(src=url_for('/js/gallery.js') defer)
  body
    main.album-detail
      #album-works.photo-grid(style=page.wall.style)
        each tile, index in page.wall.tiles
          -
            const photo = tile.photo
            const large = '/gallery/media/' + photo.sha + '.webp'
            const thumb = '/gallery/thumbs/' + photo.sha + '.webp'
            const small = '/gallery/thumbs/small/' + photo.sha + '.webp'
            const w1 = thumbnailWidth(photo, 384), w2 = thumbnailWidth(photo, 640)
            const sources = w1 < w2 ? small + ' ' + w1 + 'w, ' + thumb + ' ' + w2 + 'w' : undefined
            const alt = photo.file === album.cover && album.alt ? (en ? album.alt.en : album.alt.zh) : title + (en ? ', photo ' : '，第 ') + (index + 1) + (en ? '' : ' 张')
          a.photo-print(style=tile.style href=large data-original=originalRoot + encodeURIComponent(photo.file) aria-label=(en ? 'Enlarge ' : '放大') + alt)
            if index < 5
              +wallThumbnail(photo, thumb, small, sources, tile.sizes.join(', '), alt, index)
            else
              template
                +wallThumbnail(photo, thumb, small, sources, tile.sizes.join(', '), alt, index)
              noscript
                img(src=small width=photo.width height=photo.height alt=alt loading='lazy')
      nav.album-dock.glass(aria-label=en ? 'Album controls' : '相册控制')
        a.control(href=url_for('/gallery/') aria-label=galleryTitle title=galleryTitle)
          +icon('m14 5-7 7 7 7')
        h1= title
        button.motion-toggle.control(type='button' hidden data-play=en ? 'Play slow scroll' : '开始缓慢移动' data-pause=en ? 'Pause slow scroll' : '暂停缓慢移动')
          span.pause-icon(aria-hidden='true')
          span.play-icon(aria-hidden='true')
      dialog.photo-viewer(aria-label=en ? 'Photo viewer' : '照片查看器')
        .viewer-stage
          img.viewer-image(alt='' draggable='false')
        nav.viewer-dock.glass(aria-label=en ? 'Photo controls' : '照片控制')
          button.viewer-close.control(type='button' autofocus aria-label=en ? 'Close photo' : '关闭大图' title=en ? 'Close photo' : '关闭大图')
            +icon('m6 6 12 12M18 6 6 18')
          button.viewer-prev.control(type='button' aria-label=en ? 'Previous photo' : '上一张')
            +icon('m14 5-7 7 7 7')
          span.viewer-count(aria-live='polite' aria-atomic='true')
          button.viewer-next.control(type='button' aria-label=en ? 'Next photo' : '下一张')
            +icon('m10 5 7 7-7 7')
          a.viewer-original.control(target='_blank' rel='noopener' aria-label=en ? 'Open original' : '查看原图' title=en ? 'Open original' : '查看原图')
            +icon('M13 5h6v6m0-6-9 9M9 5H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3')
    if theme.busuanzi.site_uv || theme.busuanzi.site_pv || theme.busuanzi.page_pv
      script(async src=theme.asset.busuanzi || '//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js')
    if page.vercel
      script(defer src='/_vercel/speed-insights/script.js')
